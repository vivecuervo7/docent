# Copy to .env and fill in. .env stays on this machine: it's gitignored, and
# the backend never sends its values to the browser.

# An OpenAI-compatible endpoint, up to and including /v1. A local server like
# oMLX, or a hosted proxy like LiteLLM.
DOCENT_MODEL_BASE_URL=http://127.0.0.1:8000/v1

# Sent as a bearer token with every request. Leave empty for a local server
# that doesn't need one.
DOCENT_MODEL_API_KEY=

# The model to use until one is picked on the start page.
DOCENT_MODEL=gemma-4-12B-it-8bit

# How many PRs can be prepared at once. 1 suits a local model, which serves
# one request at a time; a hosted one can take more.
DOCENT_MAX_CONCURRENT_GENERATIONS=1
